{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://distrust-hyperlink-unmoral.ngrok-free.dev/api/$1",
            "transforms": [
                {
                    "type": "request.headers",
                    "op": "set",
                    "target": {
                        "key": "ngrok-skip-browser-warning"
                    },
                    "args": "1"
                }
            ]
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}